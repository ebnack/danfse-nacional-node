{
  "name": "danfse-nacional",
  "version": "0.1.0",
  "description": "Gera o DANFSe (PDF) da NFS-e Nacional a partir do XML, em Node.js. Sem certificado, sem rede, layout NT 008/2026. Aceita XML sem assinatura.",
  "main": "src/index.js",
  "bin": {
    "danfse-nacional": "bin/danfse.js"
  },
  "files": [
    "src",
    "bin",
    "assets",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test",
    "exemplo": "node exemplos/gerar.js",
    "gerar-municipios": "node scripts/gerar-municipios.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "danfse",
    "nfse",
    "nfs-e",
    "nfse-nacional",
    "nota-fiscal",
    "nota-fiscal-de-servico",
    "pdf",
    "brasil",
    "nt-008"
  ],
  "author": "Edison Nack",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ebnack/danfse-nacional-node.git"
  },
  "bugs": {
    "url": "https://github.com/ebnack/danfse-nacional-node/issues"
  },
  "homepage": "https://github.com/ebnack/danfse-nacional-node#readme",
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4"
  }
}
